---
import DocsPage from '../../../components/docs/DocsPage.astro';
import { buildDocsNav, getDocs, getDocSlug } from '../../../lib/docs';

export async function getStaticPaths() {
  const entries = await getDocs('tr');
  return entries.map((entry) => {
    const slug = getDocSlug(entry);
    return { params: { slug: slug === 'overview' ? undefined : slug }, props: { entry } };
  });
}

const { entry } = Astro.props;
const navigation = buildDocsNav('tr', await getDocs('tr'));
---

<DocsPage entry={entry} lang="tr" navigation={navigation} />
