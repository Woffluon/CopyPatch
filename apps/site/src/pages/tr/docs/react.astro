---
import DocsLayout from '../../../layouts/DocsLayout.astro';
import CodeBlock from '../../../components/ui/CodeBlock.astro';

const provider = `import { CopyPatchProvider, EditableText } from '@copypatch/react';

export function Hero() {
  return (
    <CopyPatchProvider locale="tr">
      <EditableText contentKey="hero.title" as="h1">Başlık</EditableText>
    </CopyPatchProvider>
  );
}`;
---

<DocsLayout title="React" description="React sağlayıcısını host uygulamanızdaki same-origin CopyPatch API'sine bağlayın.">
  <h1>React entegrasyonu</h1>
  <p class="lead">Sağlayıcının varsayılan API yolu <code>/__copypatch/api/v2</code>'dir. Ayrı bir URL, proxy veya CORS ayarı eklemeyin.</p>
  <CodeBlock code={provider} lang="tsx" title="Hero.tsx" />
  <p><code>?copypatch=1</code> editör arayüzünü gerektiğinde yükler. Host uygulaması backend'i aynı origin altında mount etmiş olmalıdır.</p>
  <h2>Metin güvenliği</h2>
  <p>CopyPatch metni düz metin olarak işler. <code>contentKey</code> değerleri locale başına ayrı tutulur; yayınlanan ve taslak değerler ayrı revision'larla yönetilir.</p>
</DocsLayout>
