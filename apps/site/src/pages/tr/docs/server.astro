---
import DocsLayout from '../../../layouts/DocsLayout.astro';
import CodeBlock from '../../../components/ui/CodeBlock.astro';

const cliCommands = `# Veritabani semasini baslatin ve yonetici parolasini belirleyin
npx copypatch init --db ./copypatch.sqlite

# Bagimsiz yuksek performansli sunucuyu baslatin
npx copypatch serve --port 4040 --db ./copypatch.sqlite --origin "http://localhost:5173,https://sitem.com" --mode direct

# Parolayi degistirin ve tum aktif oturumlari aninda sonlandirin
npx copypatch password --db ./copypatch.sqlite

# Bekleyen veritabani sema guncellemelerini uygulayin
npx copypatch migrate --db ./copypatch.sqlite`;

const embeddedServer = `import { createCopyPatchApp } from '@copypatch/server';
import { serve } from '@hono/node-server';

// Ozel ayarlarinizla gomulu Hono router'i olusturun
const app = createCopyPatchApp({
  dbPath: './copypatch.sqlite',
  publicOrigins: ['http://localhost:5173', 'https://sitem.com'],
  sessionSecret: process.env.COPYPATCH_SECRET || 'en-az-32-karakterli-rastgele-gizli-anahtar',
  publishingMode: 'direct', // 'direct' veya 'draft'
});

// Node.js yerel HTTP sunucusu ile calistirin
serve({
  fetch: app.fetch,
  port: 4040,
});

console.log('CopyPatch API sunucusu dinliyor: http://localhost:4040/__copypatch/api/v1');`;

const sqlitePragmas = `-- CopyPatch Otomatik SQLite Pragma Yapilandirmalari
PRAGMA journal_mode = WAL;
PRAGMA synchronous = NORMAL;
PRAGMA foreign_keys = ON;
PRAGMA busy_timeout = 5000;
PRAGMA cache_size = -64000; -- 64MB bellek onbellegi`;

const cacheFlow = `Ziyaretçi İsteği -> Bellek İçi Anlık Görüntü Önbelleği (0.2ms altı) -> JSON Yanıtı
(Genel ziyaretçi okumalarında sıfır disk I/O, sıfır SQLite sorgusu)`;
---

<DocsLayout
  title="Sunucu ve CLI Referansı"
  description="Kapsamlı CLI parametreleri, SQLite veritabanı şeması, bellek içi önbellek ve gömülü sunucu yapılandırması."
>
  <h1>Sunucu ve CLI Referansı</h1>

  <p class="lead">
    <code>@copypatch/server</code> paketi; Hono, SQLite (<code>better-sqlite3</code>) ve Drizzle ORM ile geliştirilmiş hafif ve güvenilir bir arka uç sunar. Ziyaretçi isteklerine bellek içi önbellekle 0.2ms altında yanıt verir ve yetkili editörler için güvenlik korumalı uç noktalar sağlar.
  </p>

  <h2>CLI Komut Seti</h2>
  <table>
    <thead>
      <tr>
        <th>Komut</th>
        <th>Amaç</th>
        <th>Etkileşimli Seçenekler</th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td><code>copypatch init</code></td>
        <td>SQLite şemasını başlatır, migrasyonları uygular ve yönetici parolası ister.</td>
        <td><code>--passphrase</code> verilmediyse etkileşimli olarak parola sorar.</td>
      </tr>
      <tr>
        <td><code>copypatch serve</code></td>
        <td>HTTP API sunucusunu belirtilen port üzerinden başlatır.</td>
        <td>Ziyaretçi isteklerini ve kimlik doğrulamalı düzenlemeleri dinler.</td>
      </tr>
      <tr>
        <td><code>copypatch password</code></td>
        <td>Yönetici parolasını yeniler ve mevcut tüm oturumları geçersiz kılar.</td>
        <td>Minimum uzunluk kontrolüyle yeni parola ister.</td>
      </tr>
      <tr>
        <td><code>copypatch migrate</code></td>
        <td>Bekleyen veritabanı şema güncellemelerini hizmet kesintisi olmadan uygular.</td>
        <td>Çift çalıştırmaya dayanıklı (idempotent) Drizzle migrasyonlarını çalıştırır.</td>
      </tr>
    </tbody>
  </table>

  <h2>CLI Kullanım Örnekleri</h2>
  <CodeBlock code={cliCommands} lang="bash" title="Terminal" />

  <h2>CLI Parametreleri Referansı</h2>
  <table>
    <thead>
      <tr>
        <th>Parametre</th>
        <th>Açıklama</th>
        <th>Varsayılan</th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td><code>--port, -p</code></td>
        <td>HTTP sunucusunun bağlanacağı TCP portu.</td>
        <td><code>4040</code></td>
      </tr>
      <tr>
        <td><code>--db, -d</code></td>
