---
import DocsLayout from '../../../layouts/DocsLayout.astro';
import CodeBlock from '../../../components/ui/CodeBlock.astro';

const backend = `import { createCopyPatchBackend } from '@copypatch/backend';
import { createSQLitePersistence } from '@copypatch/storage-sqlite';

const persistence = createSQLitePersistence('./data/copypatch.sqlite');
await persistence.migrate();

export const copypatch = createCopyPatchBackend({
  persistence,
  passphraseHash: process.env.COPYPATCH_PASSPHRASE_HASH!,
});`;
---

<DocsLayout title="Backend ve adaptörler" description="CopyPatch backend'i uygulamanızın içinde oluşturun.">
  <h1>Backend ve adaptörler</h1>
  <p class="lead">v2 backend'i bağımsız bir CopyPatch süreci değildir. Uygulamanızın route'u ve server render kodu aynı nesneyi paylaşır.</p>
  <CodeBlock code={backend} lang="ts" title="lib/copypatch.ts" />
  <p><code>@copypatch/node</code> native Node, Express, Fastify ve Hono adaptörlerini sağlar. Middleware'i body parser ve SPA fallback öncesinde mount edin.</p>
  <p><code>@copypatch/server</code> yalnız v1 için eski pakettir. Yeni entegrasyonlarda kullanmayın; yayınlanmış sürümler kaldırılmayacaktır.</p>
</DocsLayout>
