---
import MarketingLayout from '../layouts/MarketingLayout.astro';
import Hero from '../components/marketing/Hero.astro';
import DemoWrapper from '../components/demo/DemoWrapper.astro';
import HowItWorks from '../components/marketing/HowItWorks.astro';
import DevIntegration from '../components/marketing/DevIntegration.astro';
import WhyNotCms from '../components/marketing/WhyNotCms.astro';
import Architecture from '../components/marketing/Architecture.astro';
import SecuritySelfHosted from '../components/marketing/SecuritySelfHosted.astro';
import LocalesSection from '../components/marketing/LocalesSection.astro';
import OpenSource from '../components/marketing/OpenSource.astro';
import FinalCta from '../components/marketing/FinalCta.astro';
---

<MarketingLayout
  lang="en"
  title="CopyPatch: Let clients edit the copy. Not the website."
  description="A lightweight, self-hosted, open-source inline copy editing system for React applications. Mark approved text, let clients edit directly on the live page, and keep your layout and code completely untouched."
>
  <Hero lang="en" />
  <DemoWrapper lang="en" />
  <HowItWorks lang="en" />
  <DevIntegration lang="en" />
  <WhyNotCms lang="en" />
  <Architecture lang="en" />
  <SecuritySelfHosted lang="en" />
  <LocalesSection lang="en" />
  <OpenSource lang="en" />
  <FinalCta lang="en" />
</MarketingLayout>
