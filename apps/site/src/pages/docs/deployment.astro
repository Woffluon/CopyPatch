---
import DocsLayout from '../../layouts/DocsLayout.astro';
import CodeBlock from '../../components/ui/CodeBlock.astro';

const sqlite = `import { createSQLitePersistence } from '@copypatch/storage-sqlite';

const persistence = createSQLitePersistence({
  filename: process.env.COPYPATCH_SQLITE_PATH ?? './data/copypatch.sqlite',
  busyTimeoutMs: 5_000,
});
await persistence.migrate();`;

const postgres = `import { createPostgresPersistence } from '@copypatch/storage-postgres';

const persistence = createPostgresPersistence({
  connectionString: process.env.DATABASE_URL!,
  schema: 'copypatch',
});
await persistence.migrate();`;
---

<DocsLayout title="Deployment" description="Deploy CopyPatch v2 with the host application, using SQLite or PostgreSQL persistence.">
  <h1>Deployment</h1>
  <p class="lead">Deploy CopyPatch inside the same server-capable application that renders your site. The host route at <code>/__copypatch/api/v2</code> receives browser requests directly.</p>

  <h2>Choose storage</h2>
  <table>
    <thead><tr><th>Storage</th><th>Use when</th><th>Operation</th></tr></thead>
    <tbody>
      <tr><td>SQLite</td><td>One application instance or local deployment</td><td>Persist the database file and its WAL sidecar files.</td></tr>
      <tr><td>PostgreSQL</td><td>Several application instances need the same copy and sessions</td><td>Provide a protected connection string and run migrations.</td></tr>
    </tbody>
  </table>
  <CodeBlock code={sqlite} lang="ts" title="SQLite" />
  <CodeBlock code={postgres} lang="ts" title="PostgreSQL" />

  <h2>Production boundary</h2>
  <ul>
    <li>Serve the application over HTTPS and retain the same origin for page and API.</li>
    <li>Do not add a separate CopyPatch container, reverse proxy rule, or CORS configuration.</li>
    <li>Run storage migrations before accepting edits and include the database in your backup plan.</li>
    <li>Static-only hosting cannot offer CopyPatch editing because it cannot run the route or storage adapter.</li>
  </ul>
</DocsLayout>
