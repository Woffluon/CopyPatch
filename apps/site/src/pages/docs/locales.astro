---
import DocsLayout from '../../layouts/DocsLayout.astro';
import CodeBlock from '../../components/ui/CodeBlock.astro';

const locale = `import { CopyPatchProvider, EditableText } from '@copypatch/react';

export function LocalizedPage({ locale }: { locale: string }) {
  return <CopyPatchProvider locale={locale}>
    <EditableText contentKey="hero.title" as="h1">Welcome</EditableText>
  </CopyPatchProvider>;
}`;
---

<DocsLayout title="Locales" description="Keep published and draft CopyPatch snapshots isolated by locale.">
  <h1>Locales</h1>
  <p class="lead">A locale identifies an independent published snapshot and draft revision. Changing English copy does not change Turkish or any other locale.</p>
  <CodeBlock code={locale} lang="tsx" title="LocalizedPage.tsx" />
  <p>Use the locale from your route, request, or application state. CopyPatch validates locale identifiers before reading or mutating storage. It does not translate copy or provide an i18n routing system.</p>
</DocsLayout>
