---
import DocsLayout from '../../layouts/DocsLayout.astro';
import CodeBlock from '../../components/ui/CodeBlock.astro';

const cliCommands = `# Initialize database schema & set editor passphrase
npx copypatch init --db ./copypatch.sqlite

# Start the standalone high-performance server
npx copypatch serve --port 4040 --db ./copypatch.sqlite --origin "http://localhost:5173,https://my-website.com" --mode direct

# Change passphrase & invalidate all active sessions immediately
npx copypatch password --db ./copypatch.sqlite

# Apply any pending schema migrations
npx copypatch migrate --db ./copypatch.sqlite`;

const embeddedServer = `import { createCopyPatchApp } from '@copypatch/server';
import { serve } from '@hono/node-server';

// Create embedded Hono router with your custom settings
const app = createCopyPatchApp({
  dbPath: './copypatch.sqlite',
  publicOrigins: ['http://localhost:5173', 'https://my-website.com'],
  sessionSecret: process.env.COPYPATCH_SECRET || 'at-least-32-random-characters-secret',
  publishingMode: 'direct', // 'direct' or 'draft'
});

// Run with Node.js native HTTP server
serve({
  fetch: app.fetch,
  port: 4040,
});

console.log('CopyPatch API listening on http://localhost:4040/__copypatch/api/v1');`;

const sqlitePragmas = `-- CopyPatch Automatic SQLite Pragma Configurations
PRAGMA journal_mode = WAL;
PRAGMA synchronous = NORMAL;
PRAGMA foreign_keys = ON;
PRAGMA busy_timeout = 5000;
PRAGMA cache_size = -64000; -- 64MB memory cache`;

const cacheFlow = `Visitor Request -> In-Memory Snapshot Cache (sub-0.2ms) -> JSON Response
(Zero disk I/O, zero SQLite queries on public visitor reads)`;
---

