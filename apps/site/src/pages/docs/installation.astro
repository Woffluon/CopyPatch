---
import DocsLayout from '../../layouts/DocsLayout.astro';
import CodeBlock from '../../components/ui/CodeBlock.astro';

const install = `# React client
pnpm add @copypatch/core @copypatch/react

# Select one server integration and one storage adapter
pnpm add @copypatch/backend @copypatch/node @copypatch/storage-sqlite

# Next.js App Router users also install
pnpm add @copypatch/next`;

const scaffold = `# Generates framework and storage-specific starter files.
# It never starts a standalone server.
npx copypatch init --framework next --storage sqlite

# Apply storage migrations in the project environment.
npx copypatch migrate --storage sqlite`;
---

<DocsLayout title="Installation" description="Install CopyPatch v2 packages and scaffold an embedded, same-origin integration.">
  <h1>Install CopyPatch v2</h1>
  <p class="lead">CopyPatch requires Node.js 20 or newer and a server-capable host application.</p>

  <h2>Packages</h2>
  <table>
    <thead><tr><th>Package</th><th>Use it for</th></tr></thead>
    <tbody>
      <tr><td><code>@copypatch/core</code></td><td>Shared types and API constants.</td></tr>
      <tr><td><code>@copypatch/react</code></td><td>Provider, editable components, and editor client.</td></tr>
      <tr><td><code>@copypatch/backend</code></td><td>Embedded API runtime and authentication contract.</td></tr>
      <tr><td><code>@copypatch/storage-sqlite</code></td><td>Single-node or local SQLite persistence.</td></tr>
      <tr><td><code>@copypatch/storage-postgres</code></td><td>Shared PostgreSQL persistence across instances.</td></tr>
      <tr><td><code>@copypatch/node</code></td><td>Node, Express, Fastify, Hono adapters and CLI.</td></tr>
      <tr><td><code>@copypatch/next</code></td><td>Next.js App Router route and server helpers.</td></tr>
    </tbody>
  </table>

  <CodeBlock code={install} lang="bash" title="Terminal" />

  <h2>Initialize a project</h2>
  <p>The CLI creates route and configuration templates for the selected host and storage. Review the generated files before adding secrets or deployment settings.</p>
  <CodeBlock code={scaffold} lang="bash" title="Terminal" />

  <p>Do not use CopyPatch with a fully static export when editors must save changes. Static output has no route runtime, authentication, or persistence connection.</p>
</DocsLayout>
