---
import DocsLayout from '../../layouts/DocsLayout.astro';
import CodeBlock from '../../components/ui/CodeBlock.astro';

const express = `import express from 'express';
import { createCopyPatchBackend } from '@copypatch/backend';
import { expressMiddleware } from '@copypatch/node';
import { createSQLitePersistence } from '@copypatch/storage-sqlite';

const app = express();
const persistence = createSQLitePersistence('./data/copypatch.sqlite');
await persistence.migrate();
const backend = createCopyPatchBackend({ persistence, passphraseHash: process.env.COPYPATCH_PASSPHRASE_HASH! });

// Mount before body parsers and the SPA fallback.
app.use('/__copypatch/api/v2', expressMiddleware(backend));
app.use(express.static('dist'));
app.listen(3000);`;
---

<DocsLayout title="Vite and Node" description="Use Vite for the client build and mount CopyPatch in the Node application server.">
  <h1>Vite + Node</h1>
  <p class="lead">Vite builds the client. A Node server owns the same-origin CopyPatch route, storage, and authentication. Do not configure a Vite development proxy for CopyPatch v2.</p>
  <CodeBlock code={express} lang="ts" title="server.ts" />
  <p>Use the native, Fastify, or Hono adapter instead when that matches the host server. Mount the handler before any middleware that consumes request bodies.</p>
</DocsLayout>
