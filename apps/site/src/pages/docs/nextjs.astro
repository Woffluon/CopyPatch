---
import DocsLayout from '../../layouts/DocsLayout.astro';
import CodeBlock from '../../components/ui/CodeBlock.astro';

const route = `// app/%5F%5Fcopypatch/api/v2/[...path]/route.ts
import { createCopyPatchRouteHandlers } from '@copypatch/next/server';
import { copypatch } from '@/lib/copypatch';

export const { GET, POST, PUT, PATCH, DELETE, HEAD, OPTIONS } =
  createCopyPatchRouteHandlers(copypatch);`;

const page = `// app/[locale]/page.tsx
import { NextCopyPatchProvider, EditableText } from '@copypatch/next';
import { readPublishedSnapshot } from '@copypatch/next/server';
import { copypatch } from '@/lib/copypatch';

export default async function Page({ params }: { params: Promise<{ locale: string }> }) {
  const { locale } = await params;
  const initialSnapshot = await readPublishedSnapshot(copypatch, locale);
  return <NextCopyPatchProvider locale={locale} initialSnapshot={initialSnapshot}>
    <EditableText contentKey="hero.title" as="h1">Welcome</EditableText>
  </NextCopyPatchProvider>;
}`;
---

<DocsLayout title="Next.js App Router" description="Mount CopyPatch inside a Next.js App Router application without rewrites or a separate API service.">
  <h1>Next.js App Router</h1>
  <p class="lead">Create the v2 route in the application itself. The percent-encoded source folder keeps the public <code>/__copypatch/api/v2</code> URL routable because underscore-prefixed Next source folders are private. There is no <code>next.config</code> rewrite and no backend URL to proxy.</p>
  <CodeBlock code={route} lang="ts" title="route.ts" />
  <h2>Render a server snapshot</h2>
  <p>Reuse the backend instance from the route handler. This reads storage directly during server rendering instead of making an internal HTTP request.</p>
  <CodeBlock code={page} lang="tsx" title="page.tsx" />
  <p>Static export cannot serve the catch-all route or write edits. Deploy as a server-capable Next.js application.</p>
</DocsLayout>
