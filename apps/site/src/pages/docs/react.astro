---
import DocsLayout from '../../layouts/DocsLayout.astro';
import CodeBlock from '../../components/ui/CodeBlock.astro';

const provider = `import { CopyPatchProvider, EditableText, useCopyPatch } from '@copypatch/react';

export function App() {
  const buttonLabel = useCopyPatch('hero.cta', 'Contact us');
  return (
    <CopyPatchProvider locale="en">
      <EditableText contentKey="hero.title" as="h1">A clearer headline</EditableText>
      <button type="button">{buttonLabel}</button>
    </CopyPatchProvider>
  );
}`;
---

<DocsLayout title="React integration" description="Use CopyPatchProvider and editable React components with the default same-origin v2 API path.">
  <h1>React integration</h1>
  <p class="lead">The provider defaults to <code>/__copypatch/api/v2</code>. Leave <code>apiBase</code> unset for a normal same-origin host integration.</p>
  <CodeBlock code={provider} lang="tsx" title="App.tsx" />

  <h2>Components and hooks</h2>
  <table>
    <thead><tr><th>API</th><th>Purpose</th></tr></thead>
    <tbody>
      <tr><td><code>CopyPatchProvider</code></td><td>Sets the locale, published snapshot, and editor runtime.</td></tr>
      <tr><td><code>EditableText</code></td><td>Makes a text node editable while preserving fallback content for visitors.</td></tr>
      <tr><td><code>useCopyPatch</code></td><td>Reads editable copy for attributes and other non-node text.</td></tr>
      <tr><td><code>useEditableText</code></td><td>Builds a custom editable integration.</td></tr>
    </tbody>
  </table>

  <h2>Edit mode</h2>
  <p>Authorized users add <code>?copypatch=1</code> to a same-origin page. The provider then lazily loads the editor UI. The host must mount the v2 route before the editor can authenticate or save.</p>
</DocsLayout>
