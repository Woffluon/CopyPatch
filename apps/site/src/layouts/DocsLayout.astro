---
import BaseLayout from './BaseLayout.astro';
import Header from '../components/header/Header.astro';
import Footer from '../components/footer/Footer.astro';
import { getDocsNav, type Locale } from '../config/site';

interface Props {
  title: string;
  description?: string;
  currentPath?: string;
  lang?: Locale;
}

const pathname = Astro.url.pathname.replace(/\/$/, '') || '/docs';
const isTr = pathname.startsWith('/tr');
const currentLang: Locale = Astro.props.lang || (isTr ? 'tr' : 'en');
const { title, description } = Astro.props;

// Find current section and neighboring prev/next pages
const docsNav = getDocsNav(currentLang);
const allDocItems = docsNav.flatMap((section) => section.items);
const currentIndex = allDocItems.findIndex((item) => item.href === pathname);
const prevItem = currentIndex > 0 ? allDocItems[currentIndex - 1] : null;
const nextItem = currentIndex < allDocItems.length - 1 ? allDocItems[currentIndex + 1] : null;

// Find active section title for mobile header
const currentSection = docsNav.find((section) => section.items.some((item) => item.href === pathname));
const currentSectionTitle = currentSection ? currentSection.title : (currentLang === 'tr' ? 'Dokümantasyon' : 'Documentation');

const docsHomeHref = currentLang === 'tr' ? '/tr/docs' : '/docs';
const docsRootLabel = currentLang === 'tr' ? 'Dokümanlar' : 'Docs';
const prevLabel = currentLang === 'tr' ? '← Önceki' : '← Previous';
const nextLabel = currentLang === 'tr' ? 'Sonraki →' : 'Next →';
const sidebarTitle = currentLang === 'tr' ? 'Dokümantasyon' : 'Documentation';
const titleSuffix = currentLang === 'tr' ? 'CopyPatch Dokümantasyonu' : 'CopyPatch Docs';
---

<BaseLayout title={`${title} - ${titleSuffix}`} description={description} isDocs={true} lang={currentLang}>
  <Header isDocs={true} lang={currentLang} />

  <div class="docs-container container">
    <!-- Desktop Docs Sidebar Navigation -->
    <aside class="docs-sidebar" aria-label={sidebarTitle}>
      <div class="sidebar-inner">
        <div class="sidebar-header">
          <span class="sidebar-title">{sidebarTitle}</span>
        </div>

        <nav class="sidebar-nav">
          {
            docsNav.map((section) => (
              <div class="nav-group">
                <h4 class="group-title">{section.title}</h4>
                <ul class="group-list">
                  {section.items.map((item) => {
                    const isActive = pathname === item.href;
                    return (
                      <li>
                        <a href={item.href} class:list={['group-link', { active: isActive }]} aria-current={isActive ? 'page' : undefined}>
                          {item.title}
                        </a>
                      </li>
                    );
                  })}
                </ul>
              </div>
            ))
          }
        </nav>
      </div>
    </aside>

    <!-- Main Documentation Content -->
    <main id="main-content" class="docs-main">
      <!-- Breadcrumb & Custom Mobile Doc Navigator -->
      <div class="docs-mobile-nav">
        <button
          type="button"
          id="docs-mobile-trigger"
          class="docs-mobile-trigger"
          aria-haspopup="true"
          aria-expanded="false"
          aria-controls="docs-mobile-dropdown"
          aria-label={currentLang === 'tr' ? 'Doküman menüsünü aç' : 'Open documentation menu'}
        >
          <div class="docs-trigger-info">
            <span class="docs-trigger-section">{currentSectionTitle}</span>
            <span class="docs-trigger-title">{title}</span>
          </div>
          <div class="docs-trigger-badge">
            <span>{currentLang === 'tr' ? 'Menü' : 'Menu'}</span>
            <svg class="docs-trigger-chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="6 9 12 15 18 9"></polyline>
            </svg>
          </div>
        </button>

        <div id="docs-mobile-dropdown" class="docs-dropdown-panel" hidden>
          <div class="docs-dropdown-inner">
            {
              docsNav.map((section) => (
                <div class="docs-dropdown-group">
                  <div class="docs-dropdown-group-title">{section.title}</div>
                  <div class="docs-dropdown-list">
                    {section.items.map((item) => {
                      const isActive = pathname === item.href;
                      return (
                        <a
                          href={item.href}
                          class:list={['docs-dropdown-item', { active: isActive }]}
                          aria-current={isActive ? 'page' : undefined}
                        >
                          <span class="docs-item-bullet" aria-hidden="true" />
                          <span class="docs-item-name">{item.title}</span>
                          {isActive && (
                            <svg class="docs-item-check" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                              <polyline points="20 6 9 17 4 12" />
                            </svg>
                          )}
                        </a>
                      );
                    })}
                  </div>
                </div>
              ))
            }
          </div>
        </div>
      </div>

      <nav class="docs-breadcrumb" aria-label={currentLang === 'tr' ? 'Gezinme Yolu' : 'Breadcrumbs'}>
        <a href={docsHomeHref}>{docsRootLabel}</a>
        <span class="breadcrumb-sep">/</span>
        <span class="breadcrumb-current">{title}</span>
      </nav>

      <article class="prose docs-article">
        <slot />
      </article>

      <!-- Prev / Next Pagination -->
      <nav class="docs-pagination" aria-label={currentLang === 'tr' ? 'Sayfa gezintisi' : 'Page navigation'}>
        {
          prevItem ? (
            <a href={prevItem.href} class="pagination-link prev">
              <span class="pagination-sub">{prevLabel}</span>
              <span class="pagination-title">{prevItem.title}</span>
            </a>
          ) : <div />
        }
        {
          nextItem ? (
            <a href={nextItem.href} class="pagination-link next">
              <span class="pagination-sub">{nextLabel}</span>
              <span class="pagination-title">{nextItem.title}</span>
            </a>
          ) : <div />
        }
      </nav>
    </main>
  </div>

  <Footer lang={currentLang} />
</BaseLayout>

<script>
  const trigger = document.getElementById('docs-mobile-trigger');
  const dropdown = document.getElementById('docs-mobile-dropdown');

  if (trigger && dropdown) {
    const toggleDropdown = () => {
      const isExpanded = trigger.getAttribute('aria-expanded') === 'true';
      const nextExpanded = !isExpanded;
      trigger.setAttribute('aria-expanded', String(nextExpanded));
      dropdown.hidden = !nextExpanded;
    };

    trigger.addEventListener('click', (e) => {
      e.stopPropagation();
      toggleDropdown();
    });

    // Close on click outside
    document.addEventListener('click', (e) => {
      if (!dropdown.hidden && !dropdown.contains(e.target as Node) && !trigger.contains(e.target as Node)) {
        trigger.setAttribute('aria-expanded', 'false');
        dropdown.hidden = true;
      }
    });

    // Close on Escape
    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !dropdown.hidden) {
        trigger.setAttribute('aria-expanded', 'false');
        dropdown.hidden = true;
        trigger.focus();
      }
    });
  }
</script>

<style>
  .docs-container {
    display: grid;
    grid-template-columns: 260px minmax(0, 1fr);
    gap: var(--cp-space-10);
    padding-top: var(--cp-space-8);
    padding-bottom: var(--cp-space-16);
    flex: 1;
    width: 100%;
    min-width: 0;
    max-width: 100%;
    box-sizing: border-box;
  }

  .docs-sidebar {
    position: sticky;
    top: calc(var(--cp-header-height) + 2rem);
    height: calc(100vh - var(--cp-header-height) - 4rem);
    overflow-y: auto;
    padding-right: 1rem;
    border-right: 1px solid var(--cp-border-subtle);
  }

  .sidebar-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1.5rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--cp-border-subtle);
  }

  .sidebar-title {
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--cp-text);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .sidebar-nav {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .group-title {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--cp-text-dim);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: 0.5rem;
  }

  .group-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .group-link {
    display: block;
    font-size: 0.875rem;
    color: var(--cp-text-muted);
    padding: 0.35rem 0.625rem;
    border-radius: var(--cp-radius-sm);
    transition: all var(--cp-transition-fast);
  }

  .group-link:hover {
    color: var(--cp-text);
    background-color: var(--cp-surface);
  }

  .group-link.active {
    color: var(--cp-text);
    background-color: var(--cp-surface-elevated);
    font-weight: 700;
  }

  .docs-main {
    width: 100%;
    min-width: 0;
    max-width: var(--cp-prose-width);
    box-sizing: border-box;
  }

  /* Custom Mobile Doc Navigator */
  .docs-mobile-nav {
    display: none;
    position: relative;
    margin-bottom: 1.5rem;
    width: 100%;
    min-width: 0;
  }

  .docs-mobile-trigger {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.65rem 0.875rem;
    background-color: var(--cp-surface);
    border: 1px solid var(--cp-border);
    border-radius: var(--cp-radius-md);
    color: var(--cp-text);
    cursor: pointer;
    text-align: left;
    transition: all var(--cp-transition-fast);
    box-sizing: border-box;
  }

  .docs-mobile-trigger:hover,
  .docs-mobile-trigger[aria-expanded="true"] {
    border-color: var(--cp-border-hover);
    background-color: var(--cp-surface-elevated);
  }

  .docs-mobile-trigger[aria-expanded="true"] .docs-trigger-chevron {
    transform: rotate(180deg);
  }

  .docs-trigger-info {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    min-width: 0;
  }

  .docs-trigger-section {
    font-family: var(--cp-font-mono);
    font-size: 0.6875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--cp-text-dim);
  }

  .docs-trigger-title {
    font-size: 0.9375rem;
    font-weight: 700;
    color: var(--cp-text);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .docs-trigger-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.25rem 0.5rem;
    border-radius: var(--cp-radius-sm);
    background-color: var(--cp-accent-subtle);
    border: 1px solid var(--cp-border-subtle);
    font-family: var(--cp-font-mono);
    font-size: 0.6875rem;
    font-weight: 600;
    color: var(--cp-text);
    flex-shrink: 0;
  }

  .docs-trigger-chevron {
    transition: transform var(--cp-transition-fast);
  }

  .docs-dropdown-panel {
    position: absolute;
    top: calc(100% + 6px);
    left: 0;
    right: 0;
    z-index: 100;
    background-color: var(--cp-surface);
    border: 1px solid var(--cp-border);
    border-radius: var(--cp-radius-md);
    box-shadow: 0 16px 36px -8px rgba(0, 0, 0, 0.22);
    overflow: hidden;
    max-height: 70vh;
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
  }

  .docs-dropdown-panel[hidden] {
    display: none;
  }

  .docs-dropdown-inner {
    padding: 0.75rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .docs-dropdown-group {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .docs-dropdown-group-title {
    font-family: var(--cp-font-mono);
    font-size: 0.6875rem;
    font-weight: 700;
    color: var(--cp-text-dim);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 0.25rem 0.5rem;
  }

  .docs-dropdown-list {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .docs-dropdown-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    padding: 0.5rem 0.65rem;
    border-radius: var(--cp-radius-sm);
    color: var(--cp-text-muted);
    font-size: 0.875rem;
    text-decoration: none;
    transition: all var(--cp-transition-fast);
  }

  .docs-dropdown-item:hover {
    color: var(--cp-text);
    background-color: var(--cp-surface-elevated);
  }

  .docs-dropdown-item.active {
    color: var(--cp-text);
    background-color: var(--cp-surface-elevated);
    font-weight: 700;
  }

  .docs-item-bullet {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background-color: var(--cp-border-hover);
    flex-shrink: 0;
  }

  .docs-dropdown-item.active .docs-item-bullet {
    background-color: var(--cp-text);
  }

  .docs-item-name {
    flex: 1;
    min-width: 0;
  }

  .docs-item-check {
    color: var(--cp-text);
    flex-shrink: 0;
  }

  .docs-breadcrumb {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8125rem;
    color: var(--cp-text-dim);
    margin-bottom: 1.5rem;
    flex-wrap: wrap;
  }

  .docs-breadcrumb a {
    color: var(--cp-text-muted);
  }

  .docs-breadcrumb a:hover {
    color: var(--cp-text);
  }

  .breadcrumb-sep {
    color: var(--cp-border-hover);
  }

  .breadcrumb-current {
    color: var(--cp-text);
    word-break: break-word;
  }

  .docs-article {
    width: 100%;
    min-width: 0;
    max-width: 100%;
    box-sizing: border-box;
    margin-bottom: var(--cp-space-12);
  }

  .docs-pagination {
    display: flex;
    align-items: stretch;
    justify-content: space-between;
    border-top: 1px solid var(--cp-border);
    padding-top: var(--cp-space-8);
    margin-top: var(--cp-space-12);
    gap: 1rem;
    width: 100%;
    min-width: 0;
    box-sizing: border-box;
  }

  .pagination-link {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 0.75rem 1rem;
    border: 1px solid var(--cp-border);
    border-radius: var(--cp-radius-md);
    background-color: var(--cp-surface);
    transition: all var(--cp-transition-fast);
    min-width: 0;
    max-width: 240px;
    flex: 1;
    box-sizing: border-box;
  }

  .pagination-link.next {
    text-align: right;
    margin-left: auto;
  }

  .pagination-link:hover {
    border-color: var(--cp-border-hover);
    background-color: var(--cp-surface-elevated);
  }

  .pagination-sub {
    font-size: 0.75rem;
    color: var(--cp-text-dim);
    font-weight: 500;
  }

  .pagination-title {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--cp-text);
    word-break: break-word;
  }

  @media (max-width: 860px) {
    .docs-container {
      grid-template-columns: minmax(0, 1fr);
      gap: 1.5rem;
      padding-top: 1.5rem;
    }
    .docs-sidebar {
      display: none;
    }
    .docs-mobile-nav {
      display: block;
    }
    .docs-main {
      max-width: 100%;
      width: 100%;
      min-width: 0;
    }
    .docs-article {
      max-width: 100%;
      width: 100%;
      min-width: 0;
    }
    .docs-pagination {
      flex-direction: column;
      gap: 0.75rem;
    }
    .pagination-link {
      max-width: 100%;
      width: 100%;
    }
  }
</style>
