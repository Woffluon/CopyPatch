---
import { render, type CollectionEntry } from 'astro:content';
import type { DocsSection, Locale } from '../../config/site';
import DocsLayout from '../../layouts/DocsLayout.astro';
import FrameworkChooser from './FrameworkChooser.astro';
import RequestFlow from './RequestFlow.astro';

interface Props {
  entry: CollectionEntry<'docs'>;
  lang: Locale;
  navigation: DocsSection[];
}

const { entry, lang, navigation } = Astro.props;
const { Content } = await render(entry);
const isIndex = entry.id.endsWith('/overview');
---

<DocsLayout title={entry.data.title} description={entry.data.description} lang={lang} navigation={navigation}>
  {isIndex && (
    <header class="docs-overview-intro">
      <p>{lang === 'tr' ? 'CopyPatch dokümantasyon merkezi' : 'CopyPatch documentation hub'}</p>
      <h1>{entry.data.title}</h1>
      <div class="lead">{entry.data.description}</div>
    </header>
  )}
  {isIndex && <FrameworkChooser lang={lang} />}
  {isIndex && <RequestFlow lang={lang} />}
  <Content />
</DocsLayout>

<style>
  .docs-overview-intro { border-bottom: 1px solid var(--cp-border-subtle); padding-bottom: 1.5rem; }
  .docs-overview-intro > p { color: var(--cp-accent); font: 0.72rem var(--cp-font-mono); letter-spacing: 0.04em; margin: 0 0 0.6rem; text-transform: uppercase; }
  .docs-overview-intro h1 { margin-bottom: 0.8rem; }
</style>
