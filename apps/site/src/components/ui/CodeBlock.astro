---
import { Code } from 'astro:components';

interface Props {
  code: string;
  lang?: any;
  title?: string;
}

const { code, lang = 'typescript', title } = Astro.props;
---

<div class="code-block-container">
  <div class="code-header">
    <span class="code-lang">{title || lang}</span>
    <button type="button" class="copy-btn" aria-label="Copy code to clipboard">
      <svg class="copy-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
        <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
      </svg>
      <span class="copy-text">Copy</span>
    </button>
  </div>
  <div class="code-body">
    <Code
      code={code.trim()}
      lang={lang}
      theme="one-dark-pro"
    />
  </div>
</div>

<script>
  document.querySelectorAll('.code-block-container').forEach((block) => {
    const btn = block.querySelector('.copy-btn');
    const codeEl = block.querySelector('pre code');
    if (btn && codeEl) {
      btn.addEventListener('click', async () => {
        try {
          const text = codeEl.textContent || '';
          await navigator.clipboard.writeText(text);
          const textSpan = btn.querySelector('.copy-text');
          if (textSpan) {
            textSpan.textContent = 'Copied!';
            btn.classList.add('copied');
            setTimeout(() => {
              textSpan.textContent = 'Copy';
              btn.classList.remove('copied');
            }, 2000);
          }
        } catch (err) {
          console.error('Clipboard copy failed:', err);
        }
      });
    }
  });
</script>

<style>
  .code-block-container {
    position: relative;
    margin: 1.25rem 0;
    border-radius: var(--radius-cards);
    border: 1px solid var(--color-graphite);
    background-color: var(--color-carbon);
    overflow: hidden;
    width: 100%;
    max-width: 100%;
    min-width: 0;
    box-sizing: border-box;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.4);
  }

  .code-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.5rem 1rem;
    background-color: var(--color-obsidian);
    border-bottom: 1px solid var(--color-graphite);
  }

  .code-lang {
    font-family: var(--cp-font-mono);
    font-size: 0.75rem;
    font-weight: 510;
    color: var(--color-fog);
    letter-spacing: -0.011em;
  }

  .copy-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.35rem;
    background: transparent;
    border: 1px solid var(--color-graphite);
    border-radius: var(--radius-badges);
    color: var(--color-mist);
    padding: 0.25rem 0.6rem;
    min-height: 28px;
    font-size: 0.75rem;
    font-family: var(--cp-font-mono);
    cursor: pointer;
    transition: all var(--cp-transition-fast);
  }

  .copy-btn:hover {
    color: #ffffff;
    border-color: var(--color-smoke);
    background-color: var(--color-carbon);
  }

  .copy-btn.copied {
    color: var(--color-pulse-green);
    border-color: var(--color-pulse-green);
    background-color: rgba(39, 166, 68, 0.15);
  }

  .code-body {
    width: 100%;
    max-width: 100%;
    min-width: 0;
    overflow-x: auto;
    background-color: var(--color-carbon);
    -webkit-overflow-scrolling: touch;
  }

  .code-body :global(pre) {
    margin: 0 !important;
    border: none !important;
    border-radius: 0 !important;
    padding: 1rem 1.25rem !important;
    background-color: transparent !important;
    width: 100%;
    max-width: 100%;
    min-width: 0;
    box-sizing: border-box;
    overflow-x: auto;
    font-family: var(--cp-font-mono) !important;
    line-height: 1.6 !important;
    -webkit-overflow-scrolling: touch;
  }

  .code-body :global(code) {
    font-size: 0.8125rem !important;
    font-family: var(--cp-font-mono) !important;
    white-space: pre;
    word-break: normal;
    overflow-wrap: normal;
  }
</style>
