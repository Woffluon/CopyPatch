---
import type { Locale } from '../../config/site';

interface Props {
  lang?: Locale;
}

const { lang = 'en' } = Astro.props;
---

<section id="architecture" class="arch-section">
  <div class="container">
    <div class="section-header fade-in">
      <div class="section-tag">{lang === 'tr' ? 'MİMARİ' : 'ARCHITECTURE'}</div>
      <h2>{lang === 'tr' ? 'Milisaniyenin altında okuma performansı' : 'Engineered for sub-millisecond efficiency'}</h2>
      <p class="section-subhead">
        {
          lang === 'tr'
            ? 'Sürekli yoklama (polling) yok, WebSocket yok, eleman başına ayrı ağ isteği yok. Önbelleğe alınan tek bir dil anlık görüntüsü tüm sayfayı besler.'
            : 'Zero polling, zero WebSockets, and zero per-element network requests. One cached locale snapshot powers the entire page.'
        }
      </p>
    </div>

    <div class="arch-grid">
      <!-- Visual Flow Diagram Card -->
      <div class="arch-diagram-card fade-in">
        <div class="card-header-bar">
          <h3 class="card-heading">{lang === 'tr' ? 'Okuma & Önbellek Veri Hattı' : 'Read & Cache Pipeline'}</h3>
          <span class="latency-badge">&lt; 0.5 ms</span>
        </div>

        <div class="pipeline-flow">
          <!-- Flow Step 1 -->
          <div class="flow-step">
            <div class="flow-badge">01</div>
            <div class="flow-body">
              <div class="flow-title-row">
                <strong>{lang === 'tr' ? 'Ziyaretçi Sayfa İsteği' : 'Public Visitor Request'}</strong>
                <span class="flow-method">HTTP / 304</span>
              </div>
              <span class="flow-desc">
                {lang === 'tr' ? 'Tarayıcı standart URL ile sayfayı açar, ETag doğrulaması yapar.' : 'Browser requests the standard URL with If-None-Match ETag check.'}
              </span>
            </div>
          </div>

          <div class="flow-connector">
            <span class="connector-line"></span>
          </div>

          <!-- Flow Step 2 -->
          <div class="flow-step highlight">
            <div class="flow-badge active">02</div>
            <div class="flow-body">
              <div class="flow-title-row">
                <strong>{lang === 'tr' ? 'Bellek İçi Snapshot Haritası' : 'In-Memory Snapshot Map'}</strong>
                <span class="flow-method mono">Map&lt;string, string&gt;</span>
              </div>
              <div class="snapshot-preview-grid">
                <div class="snap-row">
                  <span class="snap-k">hero.title</span>
                  <span class="snap-arrow">→</span>
                  <span class="snap-v">{lang === 'tr' ? '"Metinleri müşterileriniz..."' : '"Let clients edit..."'}</span>
                </div>
                <div class="snap-row">
                  <span class="snap-k">hero.subtitle</span>
                  <span class="snap-arrow">→</span>
                  <span class="snap-v">{lang === 'tr' ? '"React projelerinizde..."' : '"Mark approved copy..."'}</span>
                </div>
                <div class="snap-row">
                  <span class="snap-k">footer.copy</span>
                  <span class="snap-arrow">→</span>
                  <span class="snap-v">"© 2026 CopyPatch"</span>
                </div>
              </div>
            </div>
          </div>

          <div class="flow-connector">
            <span class="connector-line"></span>
          </div>

          <!-- Flow Step 3 -->
          <div class="flow-step">
            <div class="flow-badge">03</div>
            <div class="flow-body">
              <div class="flow-title-row">
                <strong>{lang === 'tr' ? 'SQLite WAL Kalıcılığı' : 'SQLite WAL Persistence'}</strong>
                <span class="flow-method">copypatch.db</span>
              </div>
              <span class="flow-desc">
                {lang === 'tr' ? 'Tek dosya yerel veritabanı, yazma anında atomik revizyon artışı sağlar.' : 'Zero external DB server. Atomic revision increment upon writes.'}
              </span>
            </div>
          </div>
        </div>
      </div>

      <!-- Key Performance Invariants -->
      <div class="arch-features">
        <div class="arch-feat-card">
          <div class="feat-top">
            <div class="feat-icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z" />
              </svg>
            </div>
            <span class="feat-num">01</span>
          </div>
          <h4 class="feat-title">{lang === 'tr' ? 'Eleman Başına Sıfır Ek Yük' : 'Zero Per-Element Overhead'}</h4>
          <p class="feat-desc">
            {
              lang === 'tr' ? (
                <>Her bir <code>&lt;EditableText&gt;</code>, ayrı API sorguları çalıştırmadan paylaşılan bellek içi React deposundan anında okur.</>
              ) : (
                <>Every <code>&lt;EditableText&gt;</code> reads instantly from a shared in-memory React store without firing separate network queries.</>
              )
            }
          </p>
        </div>

        <div class="arch-feat-card">
          <div class="feat-top">
            <div class="feat-icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="2" y="2" width="20" height="8" rx="2" ry="2"></rect>
                <rect x="2" y="14" width="20" height="8" rx="2" ry="2"></rect>
                <line x1="6" y1="6" x2="6.01" y2="6"></line>
                <line x1="6" y1="18" x2="6.01" y2="18"></line>
              </svg>
            </div>
            <span class="feat-num">02</span>
          </div>
          <h4 class="feat-title">{lang === 'tr' ? 'Atomik Sunucu Önbelleği' : 'Atomic Server Cache'}</h4>
          <p class="feat-desc">
            {
              lang === 'tr'
                ? 'Gömülü sunucu çalışma zamanı, yazma işlemlerinde atomik olarak yenilenen sabit bir bellek haritası tutar; okuma isteklerine < 1 ms yanıt verir.'
                : 'The embedded server maintains an immutable memory cache rebuilt atomically upon writes for < 1 ms read responses.'
            }
          </p>
        </div>

        <div class="arch-feat-card">
          <div class="feat-top">
            <div class="feat-icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="10"></circle>
                <polyline points="12 6 12 12 16 14"></polyline>
              </svg>
            </div>
            <span class="feat-num">03</span>
          </div>
          <h4 class="feat-title">{lang === 'tr' ? 'Tembel Düzenleyici İzolasyonu' : 'Lazy Editor Isolation'}</h4>
          <p class="feat-desc">
            {
              lang === 'tr' ? (
                <>Normal ziyaretçiler &lt; 1 kB çalışma zamanı yükler. Düzenleme araç çubukları ve form kancaları yalnızca <code>?copypatch=1</code> istendiğinde yüklenir.</>
              ) : (
                <>Public visitors load &lt; 1 kB of runtime. Editing toolbars, auth modals, and form hooks load exclusively when <code>?copypatch=1</code> is requested.</>
              )
            }
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .arch-section {
    padding: var(--cp-section-gap) 0;
    background-color: var(--color-void);
  }

  .section-header {
    text-align: center;
    max-width: 640px;
    margin: 0 auto var(--cp-space-12);
  }

  .section-tag {
    display: inline-block;
    font-family: var(--cp-font-mono);
    font-size: 0.75rem;
    font-weight: 400;
    letter-spacing: -0.013em;
    color: var(--color-fog);
    margin-bottom: 0.75rem;
  }

  .section-header h2 {
    margin-bottom: 0.75rem;
    font-size: clamp(1.75rem, 3.5vw, 2.5rem);
    letter-spacing: -0.022em;
    font-weight: 510;
    line-height: 1.1;
    color: #ffffff;
  }

  .section-subhead {
    font-size: 1rem;
    color: var(--color-fog);
    font-weight: 400;
    line-height: 1.5;
  }

  .arch-grid {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    gap: var(--cp-space-6);
    max-width: 1040px;
    margin: 0 auto;
    align-items: stretch;
  }

  .arch-diagram-card {
    background-color: var(--color-carbon);
    border: 1px solid var(--color-graphite);
    border-radius: var(--radius-cards);
    padding: var(--cp-space-6);
    box-shadow: var(--cp-shadow-md);
    display: flex;
    flex-direction: column;
  }

  .card-header-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 0.75rem;
    margin-bottom: 1.25rem;
    border-bottom: 1px solid var(--color-graphite);
  }

  .card-heading {
    font-size: 0.8125rem;
    font-weight: 510;
    color: var(--color-mist);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .latency-badge {
    font-family: var(--cp-font-mono);
    font-size: 0.6875rem;
    font-weight: 510;
    color: var(--color-acid-lime);
    background-color: var(--color-obsidian);
    border: 1px solid var(--color-graphite);
    padding: 2px 8px;
    border-radius: var(--radius-pills);
  }

  .pipeline-flow {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .flow-step {
    display: flex;
    align-items: flex-start;
    gap: 0.875rem;
    background-color: var(--color-void);
    border: 1px solid var(--color-graphite);
    padding: 0.875rem 1rem;
    border-radius: var(--radius-inputs);
    transition: all var(--cp-transition-fast);
  }

  .flow-step.highlight {
    border-color: var(--color-acid-lime);
    background-color: var(--color-obsidian);
    box-shadow: var(--cp-shadow-sm);
  }

  .flow-badge {
    font-family: var(--cp-font-mono);
    font-size: 0.75rem;
    font-weight: 510;
    color: var(--color-fog);
    background-color: var(--color-carbon);
    border: 1px solid var(--color-graphite);
    width: 26px;
    height: 26px;
    border-radius: var(--radius-badges);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .flow-badge.active {
    background-color: var(--color-acid-lime);
    color: var(--color-void);
    border-color: var(--color-acid-lime);
  }

  .flow-body {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    width: 100%;
  }

  .flow-title-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .flow-title-row strong {
    font-size: 0.875rem;
    font-weight: 510;
    color: #ffffff;
  }

  .flow-method {
    font-family: var(--cp-font-mono);
    font-size: 0.6875rem;
    color: var(--color-fog);
    background-color: var(--color-carbon);
    padding: 1px 6px;
    border-radius: var(--radius-sm);
    border: 1px solid var(--color-graphite);
  }

  .flow-desc {
    font-size: 0.75rem;
    color: var(--color-fog);
    font-weight: 400;
    line-height: 1.4;
  }

  .flow-connector {
    display: flex;
    justify-content: flex-start;
    padding-left: 20px;
    height: 12px;
  }

  .connector-line {
    width: 2px;
    height: 100%;
    background-color: var(--color-graphite);
  }

  .snapshot-preview-grid {
    margin-top: 0.5rem;
    background-color: var(--color-void);
    border: 1px solid var(--color-graphite);
    border-radius: var(--radius-badges);
    padding: 0.5rem 0.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    font-family: var(--cp-font-mono);
    font-size: 0.6875rem;
  }

  .snap-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .snap-k {
    color: var(--color-mist);
    font-weight: 510;
  }

  .snap-arrow {
    color: var(--color-ash);
  }

  .snap-v {
    color: var(--color-fog);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .arch-features {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .arch-feat-card {
    background-color: var(--color-carbon);
    border: 1px solid var(--color-graphite);
    border-radius: var(--radius-cards);
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    transition: all var(--cp-transition-fast);
  }

  .arch-feat-card:hover {
    border-color: var(--color-smoke);
    background-color: var(--color-obsidian);
  }

  .feat-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.25rem;
  }

  .feat-icon {
    width: 32px;
    height: 32px;
    background-color: var(--color-obsidian);
    border: 1px solid var(--color-graphite);
    border-radius: var(--radius-inputs);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-mist);
  }

  .feat-num {
    font-family: var(--cp-font-mono);
    font-size: 0.75rem;
    font-weight: 510;
    color: var(--color-ash);
  }

  .feat-title {
    font-size: 0.9375rem;
    font-weight: 510;
    color: #ffffff;
    letter-spacing: -0.011em;
  }

  .feat-desc {
    font-size: 0.8125rem;
    line-height: 1.5;
    color: var(--color-fog);
    font-weight: 400;
  }

  @media (max-width: 880px) {
    .arch-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
