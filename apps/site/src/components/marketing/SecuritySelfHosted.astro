---
import type { Locale } from '../../config/site';

interface Props {
  lang?: Locale;
}

const { lang = 'en' } = Astro.props;
---

<section id="security" class="security-section">
  <div class="container">
    <div class="section-header fade-in">
      <div class="section-tag">{lang === 'tr' ? 'GÜVENLİK' : 'SECURITY'}</div>
      <h2>{lang === 'tr' ? 'Tavizsiz Kendi Sunucunuzda Güvenlik' : 'Zero-compromise self-hosted security'}</h2>
      <p class="section-subhead">
        {
          lang === 'tr'
            ? 'CopyPatch dış sunuculara sıfır veri gönderir. Kendi altyapınızda, katı kurumsal güvenlik değişmezleriyle çalışır.'
            : 'CopyPatch sends zero data to external servers. It runs in your own infrastructure with strict enterprise security invariants.'
        }
      </p>
    </div>

    <div class="security-grid stagger-children">
      <!-- Invariant 1: Plain Text Invariant -->
      <div class="security-card">
        <div class="card-top-row">
          <div class="sec-badge">INVARIANT 01</div>
          <div class="sec-icon">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
            </svg>
          </div>
        </div>
        <h3 class="sec-title">{lang === 'tr' ? 'Kesin Düz Metin Değişmezi' : 'Strict Plain-Text Invariant'}</h3>
        <p class="sec-desc">
          {
            lang === 'tr'
              ? 'Yalnızca düz metin dizgeleri kabul edilir ve kaydedilir. HTML, JSX, script etiketleri ve markdown kesin olarak reddedilir; depolanmış XSS açıklarını matematiksel olarak imkansız kılar.'
              : 'Only plain strings are accepted and persisted. HTML, JSX, script tags, and markdown are strictly rejected, making stored XSS mathematically impossible.'
          }
        </p>
        <div class="code-snippet-pill">
          <span class="code-dot"></span>
          <code>assert(typeof text === 'string')</code>
        </div>
      </div>

      <!-- Invariant 2: Argon2id Authentication -->
      <div class="security-card">
        <div class="card-top-row">
          <div class="sec-badge">INVARIANT 02</div>
          <div class="sec-icon">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
              <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
            </svg>
          </div>
        </div>
        <h3 class="sec-title">{lang === 'tr' ? 'Argon2id Parola Özetleme' : 'Argon2id Passphrase Hashing'}</h3>
        <p class="sec-desc">
          {
            lang === 'tr'
              ? 'Yönetici parolası, GPU tabanlı kaba kuvvet saldırılarına karşı 19 MiB bellek maliyeti ve 2 iterasyonla modern Argon2id algoritması kullanılarak özetlenir.'
              : 'Administrative passphrases are hashed using state-of-the-art Argon2id with 19 MiB memory cost and 2 iterations to resist GPU-based brute-force attacks.'
          }
        </p>
        <div class="code-snippet-pill">
          <span class="code-dot"></span>
          <code>{"argon2.hash(pwd, { type: argon2id, m: 19456 })"}</code>
        </div>
      </div>

      <!-- Invariant 3: HttpOnly & SameSite=Strict Sessions -->
      <div class="security-card">
        <div class="card-top-row">
          <div class="sec-badge">INVARIANT 03</div>
          <div class="sec-icon">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="10"/>
              <path d="M12 8v4l3 3"/>
            </svg>
          </div>
        </div>
        <h3 class="sec-title">{lang === 'tr' ? '256-Bit Kriptografik Oturumlar' : '256-Bit Cryptographic Sessions'}</h3>
        <p class="sec-desc">
          {
            lang === 'tr' ? (
              <>
                Düzenleyici oturumları, istemci betiklerinin erişemeyeceği <code>HttpOnly</code>, <code>SameSite=Strict</code> ve <code>Secure</code> çerezlerinde saklanan 256-bit entropili belirteçler kullanır.
              </>
            ) : (
              <>
                Editor sessions use 256-bit entropy tokens stored exclusively in <code>HttpOnly</code>, <code>SameSite=Strict</code>, and <code>Secure</code> cookies inaccessible to client scripts.
              </>
            )
          }
        </p>
        <div class="code-snippet-pill">
          <span class="code-dot"></span>
          <code>Set-Cookie: __Host-cp_session; HttpOnly; SameSite=Strict</code>
        </div>
      </div>

      <!-- Invariant 4: CSRF & Origin Validation -->
      <div class="security-card">
        <div class="card-top-row">
          <div class="sec-badge">INVARIANT 04</div>
          <div class="sec-icon">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M21 2l-2 2m-7.61 7.61a5.5 5.5 0 1 1-7.778 7.778 5.5 5.5 0 0 1 7.777-7.777zm0 0L15.5 7.5m0 0l3 3L22 7l-3-3m-3.5 3.5L19 4"/>
            </svg>
          </div>
        </div>
        <h3 class="sec-title">{lang === 'tr' ? 'Çift Belirteçli CSRF ve Origin Koruması' : 'Dual-Token CSRF & Origin Guard'}</h3>
        <p class="sec-desc">
          {
            lang === 'tr' ? (
              <>
                Tüm veri değiştiren istekler, bellekte tutulan özel <code>x-copypatch-csrf</code> başlığını zorunlu kılar ve <code>Origin</code> başlığını sunucu beyaz listesine göre doğrular.
              </>
            ) : (
              <>
                Every mutating request requires a custom memory-held <code>x-copypatch-csrf</code> header and validates the HTTP <code>Origin</code> header against explicit server whitelists.
              </>
            )
          }
        </p>
        <div class="code-snippet-pill">
          <span class="code-dot"></span>
          <code>headers['x-copypatch-csrf'] === session.csrf</code>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .security-section {
    padding: var(--cp-section-gap) 0;
    background-color: var(--color-void);
    border-top: 1px solid var(--color-graphite);
  }

  .section-header {
    text-align: center;
    max-width: 640px;
    margin: 0 auto var(--cp-space-12);
  }

  .section-tag {
    display: inline-block;
    font-family: var(--cp-font-mono);
    font-size: 0.75rem;
    font-weight: 400;
    letter-spacing: -0.013em;
    color: var(--color-fog);
    margin-bottom: 0.75rem;
  }

  .section-header h2 {
    margin-bottom: 0.75rem;
    font-size: clamp(1.75rem, 3.5vw, 2.5rem);
    letter-spacing: -0.022em;
    font-weight: 510;
    line-height: 1.1;
    color: #ffffff;
  }

  .section-subhead {
    font-size: 1rem;
    color: var(--color-fog);
    font-weight: 400;
    line-height: 1.5;
  }

  .security-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--cp-space-6);
    max-width: 1040px;
    margin: 0 auto;
  }

  .security-card {
    background-color: var(--color-carbon);
    border: 1px solid var(--color-graphite);
    border-radius: var(--radius-cards);
    padding: var(--cp-space-6);
    display: flex;
    flex-direction: column;
    box-shadow: var(--cp-shadow-sm);
    transition: all var(--cp-transition-fast);
  }

  .security-card:hover {
    border-color: var(--color-smoke);
    background-color: var(--color-obsidian);
  }

  .card-top-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.75rem;
  }

  .sec-badge {
    font-family: var(--cp-font-mono);
    font-size: 0.6875rem;
    font-weight: 510;
    color: var(--color-mist);
    letter-spacing: -0.013em;
    background-color: var(--color-obsidian);
    border: 1px solid var(--color-graphite);
    padding: 2px 8px;
    border-radius: var(--radius-badges);
  }

  .sec-icon {
    width: 28px;
    height: 28px;
    background-color: var(--color-obsidian);
    border: 1px solid var(--color-graphite);
    border-radius: var(--radius-badges);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-mist);
  }

  .sec-title {
    font-size: 1rem;
    font-weight: 510;
    color: #ffffff;
    margin-bottom: 0.5rem;
    letter-spacing: -0.011em;
  }

  .sec-desc {
    font-size: 0.8125rem;
    line-height: 1.5;
    color: var(--color-fog);
    font-weight: 400;
    margin-bottom: 1.25rem;
    flex: 1;
  }

  .code-snippet-pill {
    background-color: var(--color-void);
    border: 1px solid var(--color-graphite);
    padding: 0.5rem 0.75rem;
    border-radius: var(--radius-inputs);
    display: flex;
    align-items: center;
    gap: 8px;
    overflow-x: auto;
  }

  .code-dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background-color: var(--color-acid-lime);
    box-shadow: 0 0 4px rgba(228, 242, 34, 0.4);
    flex-shrink: 0;
  }

  .code-snippet-pill code {
    font-family: var(--cp-font-mono);
    font-size: 0.75rem;
    color: var(--color-mist);
    white-space: nowrap;
  }

  @media (max-width: 768px) {
    .security-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
