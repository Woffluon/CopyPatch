---
import { SITE_CONFIG, type Locale } from '../../config/site';
import InteractiveDemo from '../demo/InteractiveDemo';

interface Props {
  lang?: Locale;
}

const { lang = 'en' } = Astro.props;
const docsHref = lang === 'tr' ? '/tr/docs' : '/docs';
---

<section class="hero-section">
  <div class="container hero-container">
    <!-- Left Column: Value Prop & Actions -->
    <div class="hero-content fade-in">
      <h1 class="hero-headline">
        {
          lang === 'tr' ? (
            <>
              Metinleri müşterileriniz düzenlesin.<br />
              <span class="headline-highlight">Kodları ve tasarımı değil.</span>
            </>
          ) : (
            <>
              Let clients edit the copy.<br />
              <span class="headline-highlight">Not the website or code.</span>
            </>
          )
        }
      </h1>

      <p class="hero-subtext">
        {
          lang === 'tr'
            ? 'React projelerinizde onaylanan metinleri işaretleyin. Müşterileriniz doğrudan canlı sayfaya tıklasın, yazsın, kaydetsin; kod ve tasarımınız bozulmasın.'
            : 'Mark approved copy in React. Clients click directly on the live page, type, and save without touching your codebase or layout.'
        }
      </p>

      <!-- Install & Action Bar -->
      <div class="hero-actions">
        <div class="install-pill" id="hero-install-pill">
          <span class="install-prompt">$</span>
          <span class="install-cmd">pnpm add @copypatch/react</span>
          <button
            type="button"
            class="install-copy-btn"
            id="hero-copy-cmd"
            aria-label={lang === 'tr' ? 'Yükleme komutunu kopyala' : 'Copy install command'}
            title={lang === 'tr' ? 'Komutu kopyala' : 'Copy command'}
          >
            <svg class="copy-svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
              <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
            </svg>
            <span class="copied-indicator" style="display: none;">{lang === 'tr' ? 'Kopyalandı!' : 'Copied!'}</span>
          </button>
        </div>

        <div class="cta-buttons">
          <a href={docsHref} class="btn btn-primary">
            <span>{lang === 'tr' ? 'Dokümantasyonu Oku' : 'Read Documentation'}</span>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M5 12h14M12 5l7 7-7 7" />
            </svg>
          </a>
          <a href={SITE_CONFIG.githubUrl} target="_blank" rel="noopener noreferrer" class="btn btn-secondary">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
              <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
            </svg>
            <span>GitHub</span>
          </a>
        </div>
      </div>

      <!-- Micro Trust / Performance Facts Grid -->
      <div class="hero-specs">
        <div class="spec-item">
          <span class="spec-value">&lt; 1 kB</span>
          <span class="spec-label">{lang === 'tr' ? 'Ziyaretçi paketi (gzip)' : 'Visitor bundle (gzip)'}</span>
        </div>
        <div class="spec-divider"></div>
        <div class="spec-item">
          <span class="spec-value">SQLite + WAL</span>
          <span class="spec-label">{lang === 'tr' ? 'Kendi veritabanınız' : 'Self-hosted data'}</span>
        </div>
        <div class="spec-divider"></div>
        <div class="spec-item">
          <span class="spec-value">Argon2id</span>
          <span class="spec-label">{lang === 'tr' ? 'Kurumsal güvenlik' : 'Enterprise auth'}</span>
        </div>
        <div class="spec-divider"></div>
        <div class="spec-item">
          <span class="spec-value">{lang === 'tr' ? '%100 Düz Metin' : '100% Plain Text'}</span>
          <span class="spec-label">{lang === 'tr' ? 'Sıfır XSS riski' : 'Zero XSS surface'}</span>
        </div>
      </div>
    </div>

    <!-- Right Column: Interactive Live Preview -->
    <div class="hero-visual fade-in">
      <div class="hero-demo-card">
        <InteractiveDemo client:load defaultLocale={lang} siteLang={lang} compact={true} />
      </div>
    </div>
  </div>
</section>

<script>
  const copyBtn = document.getElementById('hero-copy-cmd');
  const copySvg = copyBtn?.querySelector('.copy-svg') as HTMLElement | null;
  const copiedSpan = copyBtn?.querySelector('.copied-indicator') as HTMLElement | null;

  if (copyBtn) {
    copyBtn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText('pnpm add @copypatch/react');
        if (copySvg && copiedSpan) {
          copySvg.style.display = 'none';
          copiedSpan.style.display = 'inline';
          copyBtn.classList.add('copied');
          setTimeout(() => {
            copySvg.style.display = 'inline';
            copiedSpan.style.display = 'none';
            copyBtn.classList.remove('copied');
          }, 2000);
        }
      } catch (err) {
        console.error('Clipboard copy failed:', err);
      }
    });
  }
</script>

<style>
  .hero-section {
    padding-top: var(--cp-space-16);
    padding-bottom: var(--cp-space-16);
    background-color: var(--cp-bg);
    border-bottom: 1px solid var(--cp-border-subtle);
  }

  .hero-container {
    display: grid;
    grid-template-columns: 1.05fr 1fr;
    gap: var(--cp-space-12);
    align-items: center;
  }

  .hero-content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    text-align: left;
  }

  .hero-headline {
    margin-bottom: 1.25rem;
    line-height: 1.05;
    font-size: clamp(2.25rem, 4.5vw, 3.5rem);
    letter-spacing: -0.022em;
    font-weight: 510;
    color: #ffffff;
  }

  .headline-highlight {
    color: var(--color-fog);
  }

  .hero-subtext {
    font-size: 1rem;
    color: var(--color-fog);
    font-weight: 400;
    line-height: 1.5;
    max-width: 540px;
    margin-bottom: 2rem;
  }

  .hero-actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-bottom: 2.5rem;
    width: 100%;
  }

  .install-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background-color: var(--color-carbon);
    border: 1px solid var(--color-graphite);
    padding: 0.5rem 0.875rem;
    border-radius: var(--radius-inputs);
    font-family: var(--cp-font-mono);
    font-size: 0.8125rem;
    box-shadow: var(--cp-shadow-sm);
    transition: border-color var(--cp-transition-fast);
  }

  .install-pill:hover {
    border-color: var(--color-smoke);
  }

  .install-prompt {
    color: var(--color-ash);
    user-select: none;
  }

  .install-cmd {
    color: var(--color-mist);
    font-weight: 400;
  }

  .install-copy-btn {
    background: transparent;
    border: none;
    color: var(--color-fog);
    cursor: pointer;
    display: flex;
    align-items: center;
    padding: 2px 4px;
    border-radius: var(--radius-sm);
    transition: color var(--cp-transition-fast);
  }

  .install-copy-btn:hover {
    color: #ffffff;
  }

  .install-copy-btn.copied {
    color: var(--color-acid-lime);
  }

  .copied-indicator {
    font-size: 0.75rem;
    font-weight: 510;
  }

  .cta-buttons {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .hero-specs {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0.75rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-graphite);
    width: 100%;
  }

  .spec-item {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .spec-value {
    font-family: var(--cp-font-mono);
    font-size: 0.875rem;
    font-weight: 510;
    color: #ffffff;
    letter-spacing: -0.013em;
  }

  .spec-label {
    font-size: 0.75rem;
    color: var(--color-ash);
    line-height: 1.3;
  }

  .spec-divider {
    display: none;
  }

  .hero-visual {
    width: 100%;
    min-width: 0;
  }

  .hero-demo-card {
    width: 100%;
    border-radius: var(--radius-cards);
    transition: transform var(--cp-transition-spring);
  }

  @media (max-width: 1024px) {
    .hero-container {
      grid-template-columns: 1fr;
      gap: var(--cp-space-10);
    }
    .hero-content {
      align-items: center;
      text-align: center;
    }
    .hero-actions {
      justify-content: center;
    }
    .hero-specs {
      justify-content: center;
      grid-template-columns: repeat(2, 1fr);
      gap: 1rem;
      max-width: 500px;
    }
  }

  @media (max-width: 640px) {
    .hero-actions {
      flex-direction: column;
      width: 100%;
    }
    .install-pill {
      width: 100%;
      justify-content: space-between;
    }
    .cta-buttons {
      width: 100%;
      flex-direction: column;
    }
    .cta-buttons .btn {
      width: 100%;
    }
  }
</style>
