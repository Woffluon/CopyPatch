---
import { SITE_CONFIG, type Locale } from '../../config/site';

interface Props {
  lang?: Locale;
}

const { lang = 'en' } = Astro.props;
const docsHref = lang === 'tr' ? '/tr/docs' : '/docs';
---

<section class="final-cta-section">
  <div class="container">
    <div class="final-cta-card fade-in">
      <div class="section-tag">{lang === 'tr' ? 'HEMEN BAŞLAYIN' : 'GET STARTED'}</div>
      <h2 class="final-headline">
        {
          lang === 'tr' ? (
            <>
              Müşterinizin bir cümleyi değiştirmesi gerekiyor.<br />
              <span class="final-highlight">Bunun için geliştiricinin yeni bir dağıtım yapmasına gerek olmamalı.</span>
            </>
          ) : (
            <>
              Your client needs to change a sentence.<br />
              <span class="final-highlight">They shouldn't need a developer deployment.</span>
            </>
          )
        }
      </h2>

      <p class="final-subtext">
        {
          lang === 'tr'
            ? 'Hafif React kütüphanesini hemen kurun; uygulama mimarinizden ödün vermeden müşterilerinize sayfa içi düzenleme süper gücü kazandırın.'
            : 'Install the lightweight React library today and give your clients inline editing superpower without sacrificing your application architecture.'
        }
      </p>

      <div class="final-actions">
        <a href={docsHref} class="btn btn-primary btn-lg">
          <span>{lang === 'tr' ? '2 Dakikada Başlayın' : 'Get Started in 2 Minutes'}</span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M5 12h14M12 5l7 7-7 7" />
          </svg>
        </a>
        <a href={SITE_CONFIG.githubUrl} target="_blank" rel="noopener noreferrer" class="btn btn-secondary btn-lg">
          <span>{lang === 'tr' ? "GitHub'da İnceleyin" : 'View on GitHub'}</span>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .final-cta-section {
    padding: var(--cp-section-gap) 0;
    background-color: var(--color-void);
    border-top: 1px solid var(--color-graphite);
  }

  .final-cta-card {
    max-width: 860px;
    margin: 0 auto;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .section-tag {
    display: inline-block;
    font-family: var(--cp-font-mono);
    font-size: 0.75rem;
    font-weight: 400;
    letter-spacing: -0.013em;
    color: var(--color-fog);
    margin-bottom: 0.75rem;
  }

  .final-headline {
    font-size: clamp(2rem, 4vw, 3rem);
    line-height: 1.05;
    margin-bottom: 1rem;
    letter-spacing: -0.022em;
    font-weight: 510;
    color: #ffffff;
  }

  .final-highlight {
    color: var(--color-fog);
  }

  .final-subtext {
    font-size: 1rem;
    color: var(--color-fog);
    font-weight: 400;
    max-width: 600px;
    margin-bottom: 2.25rem;
    line-height: 1.5;
  }

  .final-actions {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
    justify-content: center;
  }

  @media (max-width: 640px) {
    .final-actions {
      flex-direction: column;
      width: 100%;
    }
    .final-actions .btn {
      width: 100%;
    }
  }
</style>
