---
import CodeBlock from '../ui/CodeBlock.astro';
import type { Locale } from '../../config/site';

interface Props {
  lang?: Locale;
}

const { lang = 'en' } = Astro.props;

const viteCode = lang === 'tr' ? `import React from 'react';
import { CopyPatchProvider, EditableText } from '@copypatch/react';

export function LandingPage() {
  return (
    <CopyPatchProvider locale="tr">
      <header>
        <EditableText contentKey="nav.brand" as="span">
          Acme Stüdyo
        </EditableText>
      </header>

      <main>
        <EditableText contentKey="hero.title" as="h1">
          Üretken ekipler için modern geliştirme araçları.
        </EditableText>
        
        <EditableText contentKey="hero.subtitle" as="p" allowLineBreaks={true}>
          Modern React projeleri için hızlı, erişilebilir ve kendi sunucunuzda çalışan sayfa içi metin düzenleme.
        </EditableText>
      </main>
    </CopyPatchProvider>
  );
}` : `import React from 'react';
import { CopyPatchProvider, EditableText } from '@copypatch/react';

export function LandingPage() {
  return (
    <CopyPatchProvider locale="en">
      <header>
        <EditableText contentKey="nav.brand" as="span">
          Acme Studio
        </EditableText>
      </header>

      <main>
        <EditableText contentKey="hero.title" as="h1">
          Crafting software for product-focused teams.
        </EditableText>
        
        <EditableText contentKey="hero.subtitle" as="p" allowLineBreaks={true}>
          Fast, accessible, and self-hosted inline copy editing for modern React teams.
        </EditableText>
      </main>
    </CopyPatchProvider>
  );
}`;

const nextCode = lang === 'tr' ? `// app/page.tsx (Next.js App Router Sunucu Bileşeni)
import { NextCopyPatchProvider, EditableText } from '@copypatch/next';
import { readPublishedSnapshot } from '@copypatch/next/server';
import { copypatch } from '@/lib/copypatch';

export default async function Page() {
  const locale = 'tr';
  const snapshot = await readPublishedSnapshot(copypatch, locale);

  return (
    <NextCopyPatchProvider
      locale={locale}
      initialSnapshot={snapshot}
    >
      <EditableText contentKey="hero.title" as="h1">
        Next.js ile Sunucuda Önceden Render Edilen Metin
      </EditableText>
    </NextCopyPatchProvider>
  );
}` : `// app/page.tsx (Next.js App Router Server Component)
import { NextCopyPatchProvider, EditableText } from '@copypatch/next';
import { readPublishedSnapshot } from '@copypatch/next/server';
import { copypatch } from '@/lib/copypatch';

export default async function Page() {
  const locale = 'en';
  const snapshot = await readPublishedSnapshot(copypatch, locale);

  return (
    <NextCopyPatchProvider
      locale={locale}
      initialSnapshot={snapshot}
    >
      <EditableText contentKey="hero.title" as="h1">
        Next.js Pre-rendered Copy
      </EditableText>
    </NextCopyPatchProvider>
  );
}`;

const serverCode = lang === 'tr' ? `# Gömülü yapılandırma ve SQLite rotası oluşturun
npx copypatch init --framework vite-node --storage sqlite

# Parola özetini üretin ve COPYPATCH_PASSPHRASE_HASH olarak saklayın
printf '%s' "$COPYPATCH_PASSPHRASE" | npx copypatch hash --stdin` : `# Generate embedded configuration and a SQLite route
npx copypatch init --framework vite-node --storage sqlite

# Generate a passphrase hash and store it as COPYPATCH_PASSPHRASE_HASH
printf '%s' "$COPYPATCH_PASSPHRASE" | npx copypatch hash --stdin`;
---

<section class="integration-section">
  <div class="container">
    <div class="section-header fade-in">
      <div class="section-tag">{lang === 'tr' ? 'ENTEGRASYON' : 'INTEGRATION'}</div>
      <h2>{lang === 'tr' ? 'Temiz koda değer veren geliştiriciler için' : 'Designed for developers who value clean code'}</h2>
      <p class="section-subhead">
        {
          lang === 'tr'
            ? 'Mevcut React ve Next.js projelerinize iki dakikadan kısa sürede doğrudan entegre olur.'
            : 'Integrates directly into existing React and Next.js applications in under two minutes.'
        }
      </p>
    </div>

    <div class="code-showcase-card fade-in">
      <div class="tab-header" role="tablist" aria-label={lang === 'tr' ? 'Entegrasyon Kodu Sekmeleri' : 'Integration Code Tabs'}>
        <button
          type="button"
          id="tab-btn-vite"
          class="tab-btn active"
          data-tab="vite"
          role="tab"
          aria-selected="true"
          aria-controls="tab-vite"
          tabindex="0"
        >
          React & Vite
        </button>
        <button
          type="button"
          id="tab-btn-next"
          class="tab-btn"
          data-tab="next"
          role="tab"
          aria-selected="false"
          aria-controls="tab-next"
          tabindex="-1"
        >
          Next.js App Router (SSR)
        </button>
        <button
          type="button"
          id="tab-btn-server"
          class="tab-btn"
          data-tab="server"
          role="tab"
          aria-selected="false"
          aria-controls="tab-server"
          tabindex="-1"
        >
          {lang === 'tr' ? 'Sunucu & CLI Kurulumu' : 'Server & CLI Setup'}
        </button>
      </div>

      <div class="tab-content" id="tab-vite" role="tabpanel" aria-labelledby="tab-btn-vite">
        <CodeBlock code={viteCode} lang="tsx" title="src/App.tsx" />
      </div>

      <div class="tab-content" id="tab-next" role="tabpanel" aria-labelledby="tab-btn-next" style="display: none;">
        <CodeBlock code={nextCode} lang="tsx" title="app/page.tsx" />
      </div>

      <div class="tab-content" id="tab-server" role="tabpanel" aria-labelledby="tab-btn-server" style="display: none;">
        <CodeBlock code={serverCode} lang="bash" title="Terminal" />
      </div>
    </div>
  </div>
</section>

<script>
  const tabs = Array.from(document.querySelectorAll('.tab-btn')) as HTMLButtonElement[];
  const contents = document.querySelectorAll('.tab-content');

  function activateTab(index: number) {
    tabs.forEach((t, i) => {
      const isSelected = i === index;
      t.classList.toggle('active', isSelected);
      t.setAttribute('aria-selected', String(isSelected));
      t.setAttribute('tabindex', isSelected ? '0' : '-1');
    });

    const activeTab = tabs[index];
    if (activeTab) {
      activeTab.focus();
      const targetId = `tab-${activeTab.getAttribute('data-tab')}`;
      contents.forEach((content) => {
        if (content.id === targetId) {
          (content as HTMLElement).style.display = 'block';
        } else {
          (content as HTMLElement).style.display = 'none';
        }
      });
    }
  }

  tabs.forEach((tab, index) => {
    tab.addEventListener('click', () => {
      activateTab(index);
    });

    tab.addEventListener('keydown', (e) => {
      let targetIndex = -1;
      if (e.key === 'ArrowRight') {
        targetIndex = (index + 1) % tabs.length;
      } else if (e.key === 'ArrowLeft') {
        targetIndex = (index - 1 + tabs.length) % tabs.length;
      } else if (e.key === 'Home') {
        targetIndex = 0;
      } else if (e.key === 'End') {
        targetIndex = tabs.length - 1;
      }

      if (targetIndex !== -1) {
        e.preventDefault();
        activateTab(targetIndex);
      }
    });
  });
</script>

<style>
  .integration-section {
    padding: var(--cp-section-gap) 0;
    background-color: var(--color-void);
  }

  .section-header {
    text-align: center;
    max-width: 640px;
    margin: 0 auto var(--cp-space-12);
  }

  .section-tag {
    display: inline-block;
    font-family: var(--cp-font-mono);
    font-size: 0.75rem;
    font-weight: 400;
    letter-spacing: -0.013em;
    color: var(--color-fog);
    margin-bottom: 0.75rem;
  }

  .section-header h2 {
    margin-bottom: 0.75rem;
    font-size: clamp(1.75rem, 3.5vw, 2.5rem);
    letter-spacing: -0.022em;
    font-weight: 510;
    line-height: 1.1;
    color: #ffffff;
  }

  .section-subhead {
    font-size: 1rem;
    color: var(--color-fog);
    font-weight: 400;
    line-height: 1.5;
  }

  .code-showcase-card {
    max-width: 900px;
    margin: 0 auto;
    background-color: var(--color-carbon);
    border: 1px solid var(--color-graphite);
    border-radius: var(--radius-cards);
    padding: var(--cp-space-6);
    box-shadow: var(--cp-shadow-md);
  }

  .tab-header {
    display: flex;
    gap: 0.5rem;
    border-bottom: 1px solid var(--color-graphite);
    padding-bottom: 0.75rem;
    margin-bottom: 1rem;
    overflow-x: auto;
  }

  .tab-btn {
    background: transparent;
    border: 1px solid transparent;
    color: var(--color-mist);
    padding: 0.4rem 0.875rem;
    font-size: 0.75rem;
    font-weight: 400;
    border-radius: var(--radius-badges);
    cursor: pointer;
    transition: all var(--cp-transition-fast);
    white-space: nowrap;
    font-family: var(--cp-font-mono);
  }

  .tab-btn:hover {
    color: #ffffff;
  }

  .tab-btn.active {
    background-color: var(--color-obsidian);
    border-color: var(--color-graphite);
    color: #ffffff;
    box-shadow: var(--cp-shadow-sm);
  }
</style>
