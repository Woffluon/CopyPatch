{
  "name": "copypatch-monorepo",
  "version": "3.0.2",
  "private": true,
  "description": "Open-Source Inline Copy Editing System for React",
  "type": "module",
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev:vite": "pnpm --filter \"example-vite-react\" run dev",
    "dev:next": "pnpm --filter \"example-next-app\" run dev",
    "dev:site": "pnpm --filter \"site\" run dev",
    "copypatch:migrate:sqlite": "node packages/node/dist/cli/bin.js migrate --storage sqlite",
    "copypatch:doctor": "node packages/node/dist/cli/bin.js doctor",
    "build": "pnpm --filter \"./packages/*\" run build",
    "build:site": "pnpm --filter \"site\" run build",
    "docs:verify": "node scripts/verify-docs.mjs",
    "bundle": "node scripts/measure-bundle.mjs",
    "audit:prod": "node scripts/audit-policy.mjs",
    "test": "pnpm test:unit && node --test tests/docs-contract.test.mjs && pnpm run test:tooling && pnpm run test:release",
    "test:unit": "vitest run",
    "test:tooling": "node --test scripts/tooling-contract.test.mjs scripts/bundle-exit.test.mjs",
    "test:bundle": "node --test scripts/bundle-exit.test.mjs",
    "test:packed": "node scripts/release/verify-tarball-consumers.mjs",
    "test:release": "node --test scripts/release/release.test.mjs",
    "test:coverage": "vitest run --coverage",
    "test:coverage:stable": "node scripts/verify-coverage-stability.mjs",
    "test:e2e": "playwright test",
    "test:docs": "playwright test --config playwright.docs.config.ts",
    "lint": "pnpm run typecheck",
    "typecheck": "pnpm --filter \"./packages/*\" --filter \"./examples/*\" --filter \"./apps/*\" run typecheck",
    "typecheck:packages": "pnpm --filter \"./packages/*\" --filter \"example-next-app\" --filter \"example-react-router-framework\" --filter \"example-vite-node\" --filter \"example-vite-react\" run typecheck",
    "clean": "node scripts/safe-clean.mjs",
    "release:prepare": "node scripts/release/prepare-version.mjs",
    "release:verify": "node scripts/release/check-version.mjs",
    "release:check": "node scripts/release/check-version.mjs --history HEAD",
    "release:pack": "node scripts/release/pack-packages.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.13.3",
    "@vitest/coverage-v8": "^3.2.7",
    "esbuild": "^0.25.0",
    "jsdom": "^26.1.0",
    "playwright": "^1.50.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
