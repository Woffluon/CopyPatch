{
  "name": "@copypatch/core",
  "version": "1.0.0",
  "description": "Shared types, contracts, constants, and validation for CopyPatch",
  "license": "MIT",
  "type": "module",
  "homepage": "https://copypatch.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Woffluon/CopyPatch.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/Woffluon/CopyPatch/issues"
  },
  "keywords": [
    "copypatch",
    "content-editing",
    "inline-editing",
    "react",
    "headless-cms",
    "typescript"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "typescript": "^5.8.0"
  }
}
