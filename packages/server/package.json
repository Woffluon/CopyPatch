{
  "name": "@copypatch/server",
  "version": "0.1.0",
  "description": "Embedded and standalone backend server & CLI for CopyPatch",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "copypatch": "./dist/cli/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./cli": {
      "types": "./dist/cli/index.d.ts",
      "import": "./dist/cli/index.js",
      "default": "./dist/cli/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@copypatch/core": "workspace:*",
    "@node-rs/argon2": "^2.0.2",
    "@hono/node-server": "^1.13.8",
    "better-sqlite3": "^11.8.1",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.7.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^24.0.0",
    "typescript": "^5.8.0"
  }
}
