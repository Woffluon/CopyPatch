{
  "name": "@copypatch/node",
  "version": "3.0.2",
  "description": "Node.js adapters and project CLI for CopyPatch",
  "license": "MIT",
  "type": "module",
  "homepage": "https://copypatch.vercel.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Woffluon/CopyPatch.git",
    "directory": "packages/node"
  },
  "bugs": {
    "url": "https://github.com/Woffluon/CopyPatch/issues"
  },
  "keywords": [
    "copypatch",
    "node",
    "express",
    "fastify",
    "hono",
    "content-editing"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "copypatch": "./dist/cli/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./cli": {
      "types": "./dist/cli/index.d.ts",
      "import": "./dist/cli/index.js",
      "default": "./dist/cli/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "./dist/cli/bin.js"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "typecheck": "tsc --noEmit",
    "clean": "node ../../scripts/safe-clean.mjs --package=packages/node",
    "prepublishOnly": "node ../../scripts/release/reject-source-publish.mjs"
  },
  "dependencies": {
    "@copypatch/core": "workspace:*"
  },
  "peerDependencies": {
    "@copypatch/backend": "workspace:*",
    "@copypatch/storage-postgres": "workspace:*",
    "@copypatch/storage-sqlite": "workspace:*",
    "@node-rs/argon2": "^2.0.2"
  },
  "peerDependenciesMeta": {
    "@copypatch/backend": {
      "optional": true
    },
    "@copypatch/storage-postgres": {
      "optional": true
    },
    "@copypatch/storage-sqlite": {
      "optional": true
    },
    "@node-rs/argon2": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.8.0"
  }
}
