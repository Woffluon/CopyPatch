{
  "name": "@copypatch/storage-sqlite",
  "version": "3.0.1",
  "description": "SQLite persistence adapter for CopyPatch",
  "license": "MIT",
  "type": "module",
  "homepage": "https://copypatch.vercel.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Woffluon/CopyPatch.git",
    "directory": "packages/storage-sqlite"
  },
  "bugs": {
    "url": "https://github.com/Woffluon/CopyPatch/issues"
  },
  "keywords": [
    "copypatch",
    "sqlite",
    "persistence",
    "content-editing"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --root ../.. packages/storage-sqlite/tests/storage-sqlite.test.ts",
    "test:coverage": "vitest run --root ../.. --coverage packages/storage-sqlite/tests/storage-sqlite.test.ts",
    "clean": "node ../../scripts/safe-clean.mjs --package=packages/storage-sqlite",
    "prepublishOnly": "node ../../scripts/release/reject-source-publish.mjs"
  },
  "dependencies": {
    "@copypatch/core": "workspace:*",
    "better-sqlite3": "^12.11.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^24.0.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.7"
  }
}
